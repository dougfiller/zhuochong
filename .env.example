# Environment variable catalog for local development.
# Copying this file does not automatically load it into every Rust, Node, or
# Python process. Inject the required values through your shell, IDE, task runner,
# or service configuration. Never commit real secrets or private data paths.

# MCP Server only: paths to the Work Review database and application config.
# Keep these unset to use platform defaults; an empty value would override the
# defaults with an invalid path.
# WORK_REVIEW_DB_PATH=C:/absolute/path/work_review.db
# WORK_REVIEW_CONFIG_PATH=C:/absolute/path/config.json

# Optional Rust logging filter.
# RUST_LOG=work_review=info,work_review_core=info

# Optional PaddleOCR overrides. Leave blank to use normal platform discovery and
# PaddleOCR defaults.
# WORK_REVIEW_PADDLE_PYTHON=C:/absolute/path/python.exe
# WORK_REVIEW_PADDLE_DET_MODEL_NAME=
# WORK_REVIEW_PADDLE_REC_MODEL_NAME=
# WORK_REVIEW_PADDLE_OCR_VERSION=

# README screenshot tooling. Must be a valid HTTP(S) URL.
README_CAPTURE_BASE_URL=http://127.0.0.1:5173

# Vite build debugging. Only uncomment when needed. Do not use "false" or "0":
# the current config treats any non-empty value as enabled.
# TAURI_DEBUG=1

# Optional Python examples under desktop/learning/. The desktop application's
# model credentials should be configured in the application UI instead.
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Explicit, ignored local knowledge-quality probe. The endpoint must remain a
# loopback Ollama endpoint; do not point this probe at an external service.
# AICH8_KNOWLEDGE_PROBE_ENDPOINT=http://127.0.0.1:11434
# AICH8_KNOWLEDGE_PROBE_MODEL=nomic-embed-text

# Optional Linux installer-script inputs. These scripts do not load this file;
# export the selected value in the invoking shell.
# WR_APPIMAGE=/absolute/path/Work_Review.AppImage
# WR_DEB=/absolute/path/work-review.deb
# WR_DEB_URL=https://example.invalid/work-review.deb
